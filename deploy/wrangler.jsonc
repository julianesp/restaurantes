{
  // Configuración de DESPLIEGUE con wrangler. Apunta a la salida de `npm run build`
  // (vite + vinext). Los bindings deben coincidir con los de cloudflare.config.ts.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "restaurantes",
  "main": "../.cloudflare/output/v0/workers/default/bundle/index.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  // Sin keep_names: wrangler re-empaqueta con esbuild y, con esta opción (activa por defecto), mete
  // llamadas a __name() dentro de funciones que se serializan a texto (el script en línea de
  // next-themes), que en el navegador fallan con "ReferenceError: __name is not defined".
  "keep_names": false,
  "assets": {
    "directory": "../.cloudflare/output/v0/workers/default/assets",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurantes",
      "database_id": "3fc1369d-6fde-4a9b-891e-af980ff1723f",
      "migrations_dir": "../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "restaurantes-media" }],
  // Lunes 05:00 UTC: plato ganador de la semana anterior (ver worker/index.ts)
  "triggers": { "crons": ["0 5 * * 1"] },
  // Dominio de la plataforma: brasaya.com (landing) y <slug>.brasaya.com (un restaurante por subdominio).
  // Mantener en sincronía con NEXT_PUBLIC_ROOT_DOMAIN del script "deploy" (package.json) y cloudflare.config.ts.
  // Los subdominios necesitan en la zona un registro DNS comodín "*" proxied (p. ej. AAAA 100::).
  // Mantener también la dirección *.workers.dev (al declarar rutas, wrangler la desactiva si no se indica)
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "brasaya.com/*", "zone_name": "brasaya.com" },
    { "pattern": "*.brasaya.com/*", "zone_name": "brasaya.com" }
  ],
  "vars": {
    "ADMIN_EMAILS": "julii1295@gmail.com",
    "DEFAULT_TENANT_SLUG": "restaurante"
  },
  // Secretos (wrangler secret put -c deploy/wrangler.jsonc <NOMBRE>):
  //   CLERK_SECRET_KEY, CRON_SECRET, EPAYCO_PRIVATE_KEY, TELEGRAM_BOT_TOKEN
  "observability": { "enabled": true }
}
